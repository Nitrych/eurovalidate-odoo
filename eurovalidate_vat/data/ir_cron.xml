<odoo noupdate="1">
    <!-- Inactive by default: enable it under Settings > Technical > Scheduled Actions
         once you are on a plan whose quota covers your partner count. -->
    <record id="ir_cron_eurovalidate_revalidate" model="ir.cron">
        <field name="name">EuroValidate: re-validate partner VAT numbers</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._ev_cron_revalidate(batch=200, max_age_days=30)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
